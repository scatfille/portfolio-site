{
  "name": "portfolio-site",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:docker": "node start.js",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
